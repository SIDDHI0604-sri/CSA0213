void clearInputBuffer()
{
    int c;

    while ((c = getchar()) != '\n' && c != EOF)
        ;
}

int findCustomerById(int id)
{
    int i;

    for (i = 0; i < customerCount; i++)
    {
        if (customers[i].customerId == id)
            return i;
    }

    return -1;
}

int findVehicleByRegistration(char regNo[])
{
    int i;

    for (i = 0; i < vehicleCount; i++)
    {
        if (strcmp(vehicles[i].registrationNo, regNo) == 0)
            return i;
    }

    return -1;
}

int isValidDate(struct Date d)
{
    int daysInMonth[] =
    {
        0, 31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    if (d.year < 2000)
        return 0;

    if (d.month < 1 || d.month > 12)
        return 0;

    if (d.month == 2 &&
        ((d.year % 400 == 0) ||
         (d.year % 4 == 0 && d.year % 100 != 0)))
    {
        daysInMonth[2] = 29;
    }

    if (d.day < 1 || d.day > daysInMonth[d.month])
        return 0;

    return 1;
}

void displayDate(struct Date d)
{
    printf("%02d/%02d/%04d", d.day, d.month, d.year);
}


int dateToDays(struct Date d)
{
    int y;
    int totalDays = 0;
    int daysInMonth[] =
    {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    for (y = 1; y < d.year; y++)
    {
        if ((y % 400 == 0) ||
            (y % 4 == 0 && y % 100 != 0))
        {
            totalDays += 366;
        }
        else
        {
            totalDays += 365;
        }
    }

    for (y = 0; y < d.month - 1; y++)
    {
        totalDays += daysInMonth[y];

        if (y == 1 &&
            ((d.year % 400 == 0) ||
             (d.year % 4 == 0 && d.year % 100 != 0)))
        {
            totalDays++;
        }
    }

    totalDays += d.day;

    return totalDays;
}

int dateDifference(struct Date d1, struct Date d2)
{
    return dateToDays(d2) - dateToDays(d1);
}

struct Date calculateNextDate(struct Date date, int days)
{
    struct Date result = date;

    while (days > 0)
    {
        int daysInMonth;

        if (result.month == 2)
        {
            if ((result.year % 400 == 0) ||
                (result.year % 4 == 0 && result.year % 100 != 0))
            {
                daysInMonth = 29;
            }
            else
            {
                daysInMonth = 28;
            }
        }
        else if (result.month == 4 ||
                 result.month == 6 ||
                 result.month == 9 ||
                 result.month == 11)
        {
            daysInMonth = 30;
        }
        else
        {
            daysInMonth = 31;
        }

        result.day++;

        if (result.day > daysInMonth)
        {
            result.day = 1;
            result.month++;

            if (result.month > 12)
            {
                result.month = 1;
                result.year++;
            }
        }

        days--;
    }

    return result;
}

void addCustomer()
{
    struct Customer *c;

    if (customerCount >= MAX_CUSTOMERS)
    {
        printf("\nCustomer storage is full!\n");
        return;
    }

    c = &customers[customerCount];

    c->customerId = 1001 + customerCount;

    printf("\n========== ADD CUSTOMER ==========\n");

    printf("Generated Customer ID: %d\n", c->customerId);

    printf("Enter customer name: ");
    fgets(c->name, sizeof(c->name), stdin);
    c->name[strcspn(c->name, "\n")] = '\0';

    printf("Enter phone number: ");
    fgets(c->phone, sizeof(c->phone), stdin);
    c->phone[strcspn(c->phone, "\n")] = '\0';

    printf("Enter address: ");
    fgets(c->address, sizeof(c->address), stdin);
    c->address[strcspn(c->address, "\n")] = '\0';

    customerCount++;

    printf("\nCustomer added successfully!\n");
}

void addVehicle()
{
    struct Vehicle *v;
    int customerId;
    char regNo[20];

    if (vehicleCount >= MAX_VEHICLES)
    {
        printf("\nVehicle storage is full!\n");
        return;
    }

    printf("\n========== ADD MOTORBIKE ==========\n");

    printf("Enter Customer ID: ");
    scanf("%d", &customerId);
    clearInputBuffer();

    if (findCustomerById(customerId) == -1)
    {
        printf("\nCustomer ID not found!\n");
        return;
    }

    printf("Enter registration number: ");
    fgets(regNo, sizeof(regNo), stdin);
    regNo[strcspn(regNo, "\n")] = '\0';

    if (findVehicleByRegistration(regNo) != -1)
    {
        printf("\nThis motorbike is already registered!\n");
        return;
    }

    v = &vehicles[vehicleCount];

    v->vehicleId = 2001 + vehicleCount;
    v->customerId = customerId;
    v->totalServices = 0;

    strcpy(v->registrationNo, regNo);

    printf("Enter motorbike model: ");
    fgets(v->model, sizeof(v->model), stdin);
    v->model[strcspn(v->model, "\n")] = '\0';

    vehicleCount++;

    printf("\nMotorbike added successfully!\n");
    printf("Vehicle ID: %d\n", v->vehicleId);
}

void recordService()
{
    struct Service *s;
    int vehicleIndex;
    int i;

    if (serviceCount >= MAX_SERVICES)
    {
        printf("\nService storage is full!\n");
        return;
    }

    s = &services[serviceCount];

    printf("\n========== RECORD SERVICE ==========\n");

    printf("Enter registration number: ");
    fgets(s->registrationNo,
          sizeof(s->registrationNo), stdin);

    s->registrationNo[
        strcspn(s->registrationNo, "\n")
    ] = '\0';

    vehicleIndex =
        findVehicleByRegistration(s->registrationNo);

    if (vehicleIndex == -1)
    {
        printf("\nMotorbike not found!\n");
        return;
    }

    s->serviceId = 3001 + serviceCount;

    printf("Enter service date (DD MM YYYY): ");
    scanf("%d %d %d",
          &s->serviceDate.day,
          &s->serviceDate.month,
          &s->serviceDate.year);

    clearInputBuffer();

    if (!isValidDate(s->serviceDate))
    {
        printf("\nInvalid date entered!\n");
        return;
    }

    printf("Enter service type: ");
    fgets(s->serviceType,
          sizeof(s->serviceType), stdin);

    s->serviceType[
        strcspn(s->serviceType, "\n")
    ] = '\0';

    printf("How many components were replaced? ");
    scanf("%d", &s->componentCount);
    clearInputBuffer();

    if (s->componentCount <= 0)
    {
        printf("\nNo components were added.\n");

        s->componentCount = 0;
        s->components = NULL;
    }
    else
    {
        s->components =
            (struct Component *)malloc(
                s->componentCount *
                sizeof(struct Component)
            );

        if (s->components == NULL)
        {
            printf("\nMemory allocation failed!\n");
            s->componentCount = 0;
            return;
        }

        for (i = 0; i < s->componentCount; i++)
        {
            printf("\n--- Component %d ---\n", i + 1);

            printf("Enter component name: ");
            fgets(s->components[i].componentName,
                  sizeof(s->components[i].componentName),
                  stdin);

            s->components[i].componentName[
                strcspn(
                    s->components[i].componentName,
                    "\n"
                )
            ] = '\0';

            printf("Enter replacement date (DD MM YYYY): ");

            scanf("%d %d %d",
                  &s->components[i].replacementDate.day,
                  &s->components[i].replacementDate.month,
                  &s->components[i].replacementDate.year);

            clearInputBuffer();

            if (!isValidDate(
                    s->components[i].replacementDate))
            {
                printf("Invalid date. Using service date.\n");

                s->components[i].replacementDate =
                    s->serviceDate;
            }

            printf("Enter service interval in days: ");
            scanf("%d",
                  &s->components[i].serviceInterval);

            clearInputBuffer();

            if (s->components[i].serviceInterval <= 0)
            {
                s->components[i].serviceInterval = 30;
                printf("Invalid interval. Defaulted to 30 days.\n");
            }

            s->components[i].nextReplacementDate =
                calculateNextDate(
                    s->components[i].replacementDate,
                    s->components[i].serviceInterval
                );
        }
    }

    vehicles[vehicleIndex].totalServices++;

    serviceCount++;

    printf("\n=====\n");
    printf("Service recorded successfully!\n");
    printf("Service ID: %d\n", s->serviceId);
    printf("Next replacement dates have been calculated.\n");
    Printf(=\n");
}

