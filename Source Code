void checkUpcomingReplacements()
{
    struct Date checkDate;
    int reminderDays;
    int i, j;
    int difference;
    int found = 0;

    printf("\n========== REPLACEMENT REMINDER ==========\n");

    printf("Enter checking date (DD MM YYYY): ");

    scanf("%d %d %d",
          &checkDate.day,
          &checkDate.month,
          &checkDate.year);

    if (!isValidDate(checkDate))
    {
        printf("\nInvalid checking date!\n");
        clearInputBuffer();
        return;
    }

    printf("Enter reminder period in days: ");
    scanf("%d", &reminderDays);

    clearInputBuffer();

    if (reminderDays < 0)
    {
        printf("\nInvalid reminder period!\n");
        return;
    }

    printf("\n====================================================\n");
    printf("             COMPONENT REPLACEMENT REMINDER\n");
    printf("====================================================\n");

    for (i = 0; i < serviceCount; i++)
    {
        for (j = 0;
             j < services[i].componentCount;
             j++)
        {
            difference =
                dateDifference(
                    checkDate,
                    services[i]
                        .components[j]
                        .nextReplacementDate
                );

            if (difference < 0)
            {
                printf("\nOVERDUE\n");
                printf("Vehicle       : %s\n",
                       services[i].registrationNo);

                printf("Component     : %s\n",
                       services[i]
                           .components[j]
                           .componentName);

                printf("Due Date      : ");

                displayDate(
                    services[i]
                        .components[j]
                        .nextReplacementDate
                );

                printf("\nDays Overdue  : %d\n",
                       -difference);

                printf("-----------------------------------------------\n");

                found = 1;
            }
            else if (difference <= reminderDays)
            {
                printf("\nDUE SOON\n");

                printf("Vehicle       : %s\n",
                       services[i].registrationNo);

                printf("Component     : %s\n",
                       services[i]
                           .components[j]
                           .componentName);

                printf("Due Date      : ");

                displayDate(
                    services[i]
                        .components[j]
                        .nextReplacementDate
                );

                printf("\nDays Remaining: %d\n",
                       difference);

                printf("-----------------------------------------------\n");

                found = 1;
            }
        }
    }

    if (!found)
    {
        printf("\nNo components are due within the specified period.\n");
    }

    printf("\n====================================================\n");
}

void generateServiceReport()
{
    char componentNames[MAX_SERVICES][50];
    int componentCounts[MAX_SERVICES];

    int uniqueCount = 0;
    int i, j;
    int found;
    int tempCount;
    char tempName[50];

    int upcomingVehicles = 0;

    struct Date today;

    printf("\n========== SERVICE ANALYSIS REPORT ==========\n");

    if (serviceCount == 0)
    {
        printf("\nNo service data available for analysis.\n");
        return;
    }

    for (i = 0; i < serviceCount; i++)
    {
        for (j = 0;
             j < services[i].componentCount;
             j++)
        {
            int k;

            found = 0;

            for (k = 0; k < uniqueCount; k++)
            {
                if (strcmp(
                        componentNames[k],
                        services[i].components[j]
                            .componentName
                    ) == 0)
                {
                    componentCounts[k]++;
                    found = 1;
                    break;
                }
            }

            if (!found)
            {
                strcpy(
                    componentNames[uniqueCount],
                    services[i].components[j]
                        .componentName
                );

                componentCounts[uniqueCount] = 1;
                uniqueCount++;
            }
        }
    }

    for (i = 0; i < uniqueCount - 1; i++)
    {
        for (j = i + 1; j < uniqueCount; j++)
        {
            if (componentCounts[j] >
                componentCounts[i])
            {
                tempCount = componentCounts[i];
                componentCounts[i] =
                    componentCounts[j];
                componentCounts[j] =
                    tempCount;

                strcpy(tempName,
                       componentNames[i]);

                strcpy(componentNames[i],
                       componentNames[j]);

                strcpy(componentNames[j],
                       tempName);
            }
        }
    }

    printf("\n-----------------------------------------------\n");
    printf("Frequently Replaced Components\n");
    printf("-----------------------------------------------\n");

    printf("%-25s %s\n",
           "Component",
           "Replacements");

    for (i = 0; i < uniqueCount; i++)
    {
        printf("%-25s %d\n",
               componentNames[i],
               componentCounts[i]);
    }

    printf("\nEnter checking date for upcoming service "
           "(DD MM YYYY): ");

    scanf("%d %d %d",
          &today.day,
          &today.month,
          &today.year);

    clearInputBuffer();

    if (!isValidDate(today))
    {
        printf("\nInvalid date!\n");
        return;
    }

    printf("\n-----------------------------------------------\n");
    printf("Vehicles Requiring Upcoming Service\n");
    printf("-----------------------------------------------\n");

    for (i = 0; i < serviceCount; i++)
    {
        int j;

        for (j = 0;
             j < services[i].componentCount;
             j++)
        {
            int difference;

            difference =
                dateDifference(
                    today,
                    services[i]
                        .components[j]
                        .nextReplacementDate
                );

            if (difference <= 30)
            {
                printf("Vehicle    : %s\n",
                       services[i].registrationNo);

                printf("Component  : %s\n",
                       services[i]
                           .components[j]
                           .componentName);

                printf("Due Date   : ");

                displayDate(
                    services[i]
                        .components[j]
                        .nextReplacementDate
                );

                printf("\n");

                if (difference >= 0)
                {
                    printf("Status     : Due within %d days\n",
                           difference);
                }
                else
                {
                    printf("Status     : Overdue\n");
                }

                printf("-----------------------------------------------\n");

                upcomingVehicles++;
            }
        }
    }

    if (upcomingVehicles == 0)
    {
        printf("No vehicles require upcoming service.\n");
    }

    printf("\n===============================================\n");
}


