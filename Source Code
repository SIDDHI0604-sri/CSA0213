void saveRecords()
{
    FILE *fp;
    int i;
    fp = fopen("customers.dat", "wb");

    if (fp == NULL)
    {
        printf("\nUnable to open customer file!\n");
        return;
    }

    fwrite(&customerCount,
           sizeof(int),
           1,
           fp);

    fwrite(customers,
           sizeof(struct Customer),
           customerCount,
           fp);

    fclose(fp);

    fp = fopen("vehicles.dat", "wb");

    if (fp == NULL)
    {
        printf("\nUnable to open vehicle file!\n");
        return;
    }

    fwrite(&vehicleCount,
           sizeof(int),
           1,
           fp);

    fwrite(vehicles,
           sizeof(struct Vehicle),
           vehicleCount,
           fp);

    fclose(fp);

    fp = fopen("services.dat", "wb");

    if (fp == NULL)
    {
        printf("\nUnable to open service file!\n");
        return;
    }

    fwrite(&serviceCount,
           sizeof(int),
           1,
           fp);

    for (i = 0; i < serviceCount; i++)
    {
        fwrite(&services[i],
               sizeof(struct Service),
               1,
               fp);

        fwrite(&services[i].componentCount,
               sizeof(int),
               1,
               fp);

        if (services[i].componentCount > 0)
        {
            fwrite(
                services[i].components,
                sizeof(struct Component),
                services[i].componentCount,
                fp
            );
        }
    }

    fclose(fp);

    printf("\nAll records saved successfully!\n");
}

void loadRecords()
{
    FILE *fp;
    int i;

    /* Load customers */

    fp = fopen("customers.dat", "rb");

    if (fp != NULL)
    {
        fread(&customerCount,
              sizeof(int),
              1,
              fp);

        fread(customers,
              sizeof(struct Customer),
              customerCount,
              fp);

        fclose(fp);
    }

    fp = fopen("vehicles.dat", "rb");

    if (fp != NULL)
    {
        fread(&vehicleCount,
              sizeof(int),
              1,
              fp);

        fread(vehicles,
              sizeof(struct Vehicle),
              vehicleCount,
              fp);

        fclose(fp);
    }

    for (i = 0; i < serviceCount; i++)
    {
        if (services[i].components != NULL)
        {
            free(services[i].components);
            services[i].components = NULL;
        }
    }


    fp = fopen("services.dat", "rb");

    if (fp != NULL)
    {
        fread(&serviceCount,
              sizeof(int),
              1,
              fp);

        for (i = 0; i < serviceCount; i++)
        {
            fread(&services[i],
                  sizeof(struct Service),
                  1,
                  fp);

                    services[i].components = NULL;

            fread(&services[i].componentCount,
                  sizeof(int),
                  1,
                  fp);

            if (services[i].componentCount > 0)
            {
                services[i].components =
                    (struct Component *)malloc(
                        services[i].componentCount *
                        sizeof(struct Component)
                    );

                if (services[i].components == NULL)
                {
                    printf("\nMemory allocation failed "
                           "while loading records!\n");

                    fclose(fp);
                    return;
                }

                fread(
                    services[i].components,
                    sizeof(struct Component),
                    services[i].componentCount,
                    fp
                );
            }
        }

        fclose(fp);

        printf("\nRecords loaded successfully!\n");
    }
    else
    {
        printf("\nNo previous service records found.\n");
    }
}

