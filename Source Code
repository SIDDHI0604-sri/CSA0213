#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#define MAX_CUSTOMERS 100
#define MAX_VEHICLES 100
#define MAX_SERVICES 500

struct Date {
    int day;
    int month;
    int year;
};

struct Customer {
    int customerId;
    char name[50];
    char phone[15];
    char address[100];
};

struct Vehicle {
    int vehicleId;
    char registrationNo[20];
    char model[50];
    int customerId;
    int totalServices;
};

struct Component {
    char componentName[50];
    struct Date replacementDate;
    int serviceInterval;
    struct Date nextReplacementDate;
};

struct Service {
    int serviceId;
    char registrationNo[20];
    struct Date serviceDate;
